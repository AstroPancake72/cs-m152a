// Module: reaction_timer
// Description: Measures a player's reaction time in milliseconds using a 100 MHz clock.
//              Counts up while timer_enable is high. Resets internal tick counter when disabled.
module reaction_timer #(
    parameter MS_COUNT = 100000 // Number of clock cycles to make 1 ms (100,000 for 100MHz clock)
)(
    input wire clk,              // 100 MHz system clock
    input wire reset,            // Active-high synchronous reset
    input wire timer_enable,     // High while measuring reaction time (LED is on)
    output reg [15:0] time_ms    // 16-bit output to display elapsed milliseconds (0 to 65,535 ms)
);

    // Internal register to count clock cycles (needs 17 bits to hold 100,000)
    reg [16:0] clk_counter;

    // Sequential logic block triggered on the rising edge of the clock
    always @(posedge clk) begin
        if (reset) begin
            // Synchronous reset clears both the millisecond score and internal counters
            time_ms     <= 16'd0;
            clk_counter <= 17'd0;
        end else if (timer_enable) begin
            // The game is active; count clock cycles
            if (clk_counter == (MS_COUNT - 1)) begin
                // Exactly 1 millisecond has passed
                clk_counter <= 17'd0;         // Reset the cycle counter back to 0
                time_ms     <= time_ms + 1'b1; // Increment the millisecond counter
            end else begin
                // Keep counting clock cycles
                clk_counter <= clk_counter + 1'b1;
            end
        end else begin
            // When timer_enable is 0:
            // The score (time_ms) pauses/freezes, but the internal cycle counter is reset
            clk_counter <= 17'd0;
        end
    end

endmodule
